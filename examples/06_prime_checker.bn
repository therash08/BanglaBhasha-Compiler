// মৌলিক সংখ্যা যাচাইকরণ ফাংশন
ফাংশন মৌলিক_কিনা(পূর্ণসংখ্যা n) -> বুলিয়ান {
    যদি (n <= 1) {
        ফেরত মিথ্যা;
    }
    পূর্ণসংখ্যা i = 2;
    বুলিয়ান মৌলিক = সত্য;
    যতক্ষণ (i * i <= n) {
        যদি (n % i == 0) {
            মৌলিক = মিথ্যা;
            থামো;
        }
        i = i + 1;
    }
    ফেরত মৌলিক;
}

লেখো("৭ কি মৌলিক সংখ্যা?");
লেখো(মৌলিক_কিনা(7));

লেখো("৯ কি মৌলিক সংখ্যা?");
লেখো(মৌলিক_কিনা(9));

লেখো("২৯ কি মৌলিক সংখ্যা?");
লেখো(মৌলিক_কিনা(29));
