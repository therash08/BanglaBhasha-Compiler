// ফাংশন ও লুপ দিয়ে ফ্যাক্টরিয়াল হিসাব
ফাংশন ফ্যাক্টরিয়াল(পূর্ণসংখ্যা n) -> পূর্ণসংখ্যা {
    পূর্ণসংখ্যা উত্তর = 1;
    পূর্ণসংখ্যা i = 1;
    যতক্ষণ (i <= n) {
        উত্তর = উত্তর * i;
        i = i + 1;
    }
    ফেরত উত্তর;
}

লেখো("৫ এর ফ্যাক্টরিয়াল:");
লেখো(ফ্যাক্টরিয়াল(5));

লেখো("৬ এর ফ্যাক্টরিয়াল:");
লেখো(ফ্যাক্টরিয়াল(6));
