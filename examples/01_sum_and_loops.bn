// ১ থেকে ১০ পর্যন্ত সংখ্যা বিশ্লেষণ ও মোট যোগফল
পূর্ণসংখ্যা সংখ্যা = 1;
পূর্ণসংখ্যা মোট = 0;

লেখো("=== সংখ্যা বিশ্লেষণ ===");
যতক্ষণ (সংখ্যা <= 10) {
    যদি (সংখ্যা % 2 == 0) {
        লেখো("জোড় সংখ্যা:");
        লেখো(সংখ্যা);
    } নাহলে {
        লেখো("বিজোড় সংখ্যা:");
        লেখো(সংখ্যা);
    }
    মোট = মোট + সংখ্যা;
    সংখ্যা = সংখ্যা + 1;
}

লেখো("১ থেকে ১০ পর্যন্ত মোট যোগফল:");
লেখো(মোট);
